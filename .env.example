# FLOW Inference Service - Environment Variables

environment=development
# Set to "development" or "production"

# API key for authenticating requests to this service.
# Required when check_api_key fails closed.
api_key=change_this_to_your_secret_key

# Redis URL.
# In Docker Compose this is overridden to redis://redis:6379/0.
redis_url=redis://localhost:6379/0

# Logging
log_level=INFO
log_to_files=False

# HTTPS redirect.
# Set to false when running behind Traefik or another reverse proxy.
https_redirect=true

# CORS
cors_allowed_origins=["http://localhost:8000","https://inference.flow-project.net"]
cors_allowed_headers=["Content-Type","X-API-KEY"]
cors_allowed_methods=["GET","POST","OPTIONS"]

# Public domain for Traefik production deployment.
APP_DOMAIN=inference.flow-project.net

# Torch variant: cpu, cu124, cu126, cu128
TORCH_VARIANT=cpu